# Aquisito · variables de entorno (SIN SECRETOS). Copiar a .env y completar.
# Separación de entornos: APP_ENV=development | test | staging | production.
# En staging/production el API NO arranca si detecta simuladores, sembrado demo o claves faltantes.

# --- General ---
APP_ENV=development
PORT=4000
# development: base local. staging/production: base gestionada con TLS y respaldos.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aquisito
# Solo pruebas automáticas (se reinicia en cada corrida; debe terminar en _test).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aquisito_test
# Orígenes permitidos para CORS (apps móviles usan Bearer; la web usa el proxy de mismo origen).
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info
# Límite de solicitudes por IP y minuto (por proceso). Complementar con el proxy/CDN.
RATE_LIMIT_PER_MINUTE=600

# --- Sesiones y cifrado ---
SESSION_TTL_HOURS=720
# Sesiones de roles sensibles (admin, finanzas) duran menos y exigen TOTP.
ADMIN_SESSION_TTL_HOURS=12
# true en cualquier entorno con HTTPS (obligatorio en staging/production).
COOKIE_SECURE=false
# 32 bytes en base64 (openssl rand -base64 32). Cifra códigos de entrega. Obligatorio fuera de dev.
DATA_ENCRYPTION_KEY=

# --- Pagos ---
# Proveedores habilitados. "sandbox" es un SIMULADOR (solo development/test).
PAYMENT_PROVIDERS=sandbox
CARD_PROVIDER=sandbox
WALLET_PROVIDER=sandbox
# Secreto HMAC del simulador (solo dev/test).
SANDBOX_WEBHOOK_SECRET=dev-sandbox-webhook-secret
# Culqi (pendiente de contrato y credenciales). Llave secreta solo en el servidor.
CULQI_SECRET_KEY=
CULQI_PUBLIC_KEY=
CULQI_API_URL=https://api.culqi.com/v2
# Transferencia manual: queda "pendiente" hasta conciliación por finanzas.
TRANSFER_PAYMENTS_ENABLED=false
PAYMENT_DEADLINE_MINUTES=15
QUOTE_TTL_MINUTES=10
OFFER_TTL_SECONDS=60

# --- SMS / OTP --- console = simulador (escribe en storage/dev-outbox/sms.log; solo dev/test)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Correo --- console (solo dev) | none (pendiente de proveedor)
EMAIL_PROVIDER=console

# --- Push --- none | expo (requiere proyecto EAS y tokens de dispositivos nativos)
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=

# --- Rutas --- haversine (aproximación etiquetada) | osrm (servidor propio)
ROUTE_PROVIDER=haversine
OSRM_URL=

# --- Archivos --- local (solo dev) | s3 (bucket PRIVADO; obligatorio en producción)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Jobs (outbox, vencimientos, despacho, conciliación, reembolsos) ---
JOBS_ENABLED=true
JOBS_INTERVAL_MS=3000

# --- Datos de demostración --- debe ser false en staging/production
ALLOW_DEMO_SEED=true
# DEMO_PASSWORD= (opcional: contraseña fija para cuentas demo locales)

# --- Web (apps/web) ---
# URL del API usada por el proxy /api/* en tiempo de ejecución.
API_URL=http://localhost:4000
# Teselas del mapa. El valor por defecto (OSM público) es SOLO para desarrollo.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Móvil (apps/*-mobile) ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
