{
  "name": "@aquisito/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "db:migrate": "node dist/db/migrate-cli.js",
    "db:seed": "node dist/db/seed-cli.js",
    "openapi": "node dist/openapi-cli.js",
    "test": "vitest run --no-file-parallelism",
    "db:reset": "node dist/db/reset-cli.js",
    "docs": "node dist/docs-cli.js"
  },
  "dependencies": {
    "@aquisito/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@swc/core": "1.13.5",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.7"
  }
}