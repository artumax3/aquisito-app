{
  "name": "aquisito",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm --filter @aquisito/api run build && pnpm --filter @aquisito/web run build",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "dev:api": "pnpm --filter @aquisito/api run dev",
    "dev:web": "pnpm --filter @aquisito/web run dev",
    "db:migrate": "pnpm --filter @aquisito/api run db:migrate",
    "db:seed": "pnpm --filter @aquisito/api run db:seed",
    "test": "pnpm --filter @aquisito/contracts run test && pnpm --filter @aquisito/api run test",
    "test:e2e": "pnpm --filter @aquisito/web run test:e2e",
    "openapi": "pnpm --filter @aquisito/api run openapi"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}